# ============================================
# Voice of Trisma — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Semua variable di sini dibaca oleh record_v1.0.py / record_v2.0.py
# atau digunakan oleh GitHub Actions workflows (via secrets).
# ============================================

# --- Stream URL ---
# URL radio stream yang akan direkam.
STREAM_URL=https://example.com/stream

# --- Archive.org credentials ---
# Digunakan untuk upload rekaman ke Archive.org.
MY_ACCESS_KEY=
MY_SECRET_KEY=

# --- Proxy ---
# Daftar proxy untuk recording (bisa URL raw list atau JSON array).
HTTP_PROXY=

# --- Optional: GitHub Gist token ---
# Digunakan untuk update stats/log.
GIST_TOKEN=

# --- Optional: Gemini API key ---
# Digunakan untuk transkripsi (workflow transcript).
GEMINI_API_KEY=

# --- Optional: Proxy tambahan untuk CI/CD ---
CDN_PROXY=
GH_PROXY=

# --- GitHub tokens (untuk CI/CD) ---
# MY_TOKEN: Personal Access Token untuk cloning repo.
# WEB_TOKEN: Token untuk deploy ke voiceoftrisma.github.io.
MY_TOKEN=
WEB_TOKEN=
