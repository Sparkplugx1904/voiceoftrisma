# ============================================
# Voice of Trisma — .gitignore
# ============================================

# --- Environment & Secrets ---
.env
.ENV
*.env
.env.*
.dev.vars

# --- Python Artifacts & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*tempCodeRunnerFile.*

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Runtime Data, Logs, & Media Outputs ---
recordings/
transcripts/
uploads/
temp_guard/
scratch/
*.jsonl
*.srt
*.wav

# --- Downloaded AI Models (Whisper GGML/GGUF) ---
!models/
!models/*.bin
*.gguf

# --- Native Executables & Local Binaries ---
*.exe
!bin/win-x64/
!bin/win-x64/*.exe
/ffmpeg
/ffprobe
/ffplay
act

# --- Node.js & Cloudflare Worker Artifacts ---
node_modules/
.wrangler/
dist/
.mf/
package.json
package-lock.json

# --- Legacy & Workspace-Specific ---
experimental/
main/mycpp/
Project/
TODO.md
graphify-out/
/workspaces/VOT-Denpasar/push
