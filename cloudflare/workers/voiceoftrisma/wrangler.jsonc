/**
 * Worker gabungan VOICE OF TRISMA
 * ---------------------------------------------------------
 * Satu worker, lima modul (route prefix dirapikan):
 *   /api/*    -> admin (login, jadwal, riwayat, log)   [KV VOT_ADMIN_STORE]
 *   /stats    -> stream-stats (proxy live + ?history=1) [KV VOT_STREAM_STATS]
 *   /archive  -> cache arsip Archive.org                [KV ARCHIVE_KV]
 *   /metrics  -> snapshot stats icecast (15:00-19:00 WITA) [KV VOT_METRICS_STORE]
 *   /workflow -> stub info (kerja lewat cron saja)
 *
 * Cron (named triggers — event.cron dipakai untuk routing):
 *   stream-stats : setiap 5 menit  poll icecast -> sample KV
 *   archive      : setiap 30 menit rekap uploads Archive.org -> KV
 *   workflow     : 07:00 UTC      trigger GHA record+transcript
 *   metrics      : setiap menit   snapshot stats (hanya jam siaran)
 *
 * Secrets (set via: npx wrangler secret put <NAMA>):
 *   ADMIN_USERNAME / ADMIN_PASSWORD / SESSION_SECRET / GITHUB_TOKEN
 *
 * KV namespace = SAMA dengan worker lama (id tidak berubah),
 * jadi data jadwal/samples/archive/metrics LANGSUNG tersedia, tanpa migrasi.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voiceoftrisma",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// NOTE: cron TIDAK dipasang di worker ini — worker lama tetap hidup di
	// Cloudflare dan memegang cron (keputusan user 2026-08-02). Jika worker
	// lama suatu saat dihapus, uncomment blok ini (limit akun free: 5 cron).
	// "triggers": {
	// 	"crons": [
	// 		"*/5 * * * *",
	// 		"*/30 * * * *",
	// 		"0 7 * * *",
	// 		"* * * * *"
	// 	]
	// },
	"kv_namespaces": [
		{
			"binding": "VOT_ADMIN_STORE",
			"id": "1f540e7af26b4142a81a34f6bf5d3d4e"
		},
		{
			"binding": "VOT_STREAM_STATS",
			"id": "2cac93d349244d9582570d15de6ecfa0"
		},
		{
			"binding": "ARCHIVE_KV",
			"id": "9c9b455afd884515a9253386bd40c87f"
		},
		{
			"binding": "VOT_METRICS_STORE",
			"id": "f850eea7bbf74c00be0cf988210e40fc"
		}
	]
}
